# Environment Variables Template for Session 06 Examples
# ========================================================
#
# IMPORTANT: This is a TEMPLATE file showing the structure of environment variables.
# DO NOT use these example values in production!
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env (without the .example extension):
#    cp .env.example .env
#
# 2. Generate a secure SECRET_KEY (see instructions below)
#
# 3. Update the values in .env with your actual configuration
#
# 4. Add .env to .gitignore to prevent committing secrets:
#    echo ".env" >> .gitignore
#
# 5. Never commit .env to version control!

# ========================================================
# SECRET_KEY - JWT Signing Secret
# ========================================================
#
# This secret is used to sign and verify JWT tokens.
# If an attacker obtains this secret, they can forge tokens for any user!
#
# GENERATE A SECURE SECRET:
# Run this command in your terminal to generate a cryptographically secure key:
#
#   openssl rand -hex 32
#
# This generates a 64-character hexadecimal string (32 bytes = 256 bits)
#
# Example output (DO NOT USE THIS - generate your own):
#   a7f3c2b8e1d4f6a9c0e2b5d8f1a3c6e9b2d4f7a0c3e5b8d1f4a6c9e2b5d8f1a3
#
# Then replace the value below:
SECRET_KEY=your-generated-secret-key-here

# If you don't have openssl, you can use Python:
#   python3 -c "import secrets; print(secrets.token_hex(32))"

# WHY IS THIS IMPORTANT?
# - Weak secrets (like "secret", "dev-key", "12345") can be guessed by attackers
# - See tests/weak_secret_attack.py for a demonstration of weak secret attacks
# - A 256-bit random secret is computationally infeasible to brute-force


# ========================================================
# DATABASE CONFIGURATION
# ========================================================
#
# Database connection string
# Format: postgresql://username:password@hostname:port/database_name
#
# For local development with SQLite (simpler, no server needed):
# DATABASE_URL=sqlite:///./todos.db
#
# For PostgreSQL in production:
# DATABASE_URL=postgresql://dbuser:dbpassword@localhost:5432/comp351_todos

DATABASE_URL=sqlite:///./todos.db


# ========================================================
# API KEYS AND THIRD-PARTY SERVICES
# ========================================================
#
# If your application uses external APIs, store their keys here
# Examples (uncomment and configure as needed):

# Email service (e.g., SendGrid)
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloud storage (e.g., AWS S3)
# AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxx
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Payment processing (e.g., Stripe)
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ========================================================
# APPLICATION CONFIGURATION
# ========================================================

# Environment mode (development, staging, production)
# This can control debug mode, logging levels, etc.
ENVIRONMENT=development

# Flask debug mode (only enable in development!)
# ⚠️ NEVER set DEBUG=True in production - it exposes sensitive information
DEBUG=True

# Application port
PORT=8000

# CORS allowed origins (for development, allow localhost)
# In production, restrict to your actual frontend domain
CORS_ORIGINS=http://localhost:3000,http://localhost:8080


# ========================================================
# SESSION CONFIGURATION (if using Flask sessions)
# ========================================================

# Session secret for Flask session cookies
# Generate with: openssl rand -hex 32
# SESSION_SECRET=another-random-secret-different-from-jwt-secret


# ========================================================
# SECURITY BEST PRACTICES
# ========================================================
#
# 1. NEVER commit .env to Git
#    - Add .env to .gitignore
#    - Commit .env.example instead (template without real secrets)
#
# 2. Use different secrets for each environment
#    - Development .env has different SECRET_KEY than production
#    - Prevents development secrets from being used in production
#
# 3. Rotate secrets regularly
#    - Change SECRET_KEY periodically (invalidates old JWTs)
#    - Update database passwords quarterly
#
# 4. Use environment-specific .env files
#    - .env.development (local development)
#    - .env.staging (testing environment)
#    - .env.production (production server)
#
# 5. In production, use secure secret management
#    - AWS Secrets Manager
#    - HashiCorp Vault
#    - Azure Key Vault
#    - Environment variables set in server configuration (not .env file)
#
# 6. Limit access to production secrets
#    - Only operations team should have access
#    - Use CI/CD pipelines to deploy without developers seeing secrets
#
# 7. Audit secret usage
#    - Log when secrets are accessed
#    - Monitor for unusual patterns
#    - Revoke and rotate if compromise suspected


# ========================================================
# LOADING ENVIRONMENT VARIABLES IN YOUR APPLICATION
# ========================================================
#
# Python (Flask/FastAPI) example:
#
# from dotenv import load_dotenv
# import os
#
# # Load .env file at application startup
# load_dotenv()
#
# # Access variables
# SECRET_KEY = os.getenv('SECRET_KEY')
# DATABASE_URL = os.getenv('DATABASE_URL')
# DEBUG = os.getenv('DEBUG', 'False') == 'True'
#
# # Validate critical variables exist
# if not SECRET_KEY:
#     raise ValueError("SECRET_KEY environment variable not set!")
#
# if SECRET_KEY in ['secret', 'dev-secret-key', 'your-generated-secret-key-here']:
#     raise ValueError("SECRET_KEY is using a weak/example value. Generate a secure key!")


